# This file contains no secret. Copy it to .env beside docker-compose.node.yml.
IMAGE=interstellar/interstellard:dev
CONTAINER_NAME=interstellard-rpc
NODE_HOME=/srv/interstellar/rpc
# Container UID/GID must be able to read and write NODE_HOME. Keep 10001 for a
# new directory created for the image user; use `id -u` / `id -g` for an
# existing directory owned by a host operator account.
NODE_UID=10001
NODE_GID=10001
CHAIN_ID=intl-testnet-1
NODE_MODE=rpc
# Comma-separated nodeID@host:port entries. Set the peers for this node only.
PERSISTENT_PEERS=replace-with-node-id@peer-host:26656
MINIMUM_GAS_PRICES=1000000000ahuge
LOG_FORMAT=json
LOG_LEVEL=info
JSON_RPC_API=eth,net,txpool,web3
EVM_INDEXER_ENABLE=true
P2P_PORT=26656
EVM_RPC_BIND=127.0.0.1
EVM_RPC_PORT=8545
EVM_WS_BIND=127.0.0.1
EVM_WS_PORT=8546
# CometBFT /metrics endpoint. Set PROMETHEUS_BIND=0.0.0.0 only when a firewall
# or cloud security group limits TCP 26660 to the Prometheus server(s).
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=26660
# Optional EVM JSON-RPC metrics (/debug/metrics/prometheus). Also change
# config/app.toml [json-rpc].metrics-address to 0.0.0.0:6065 before enabling.
EVM_RPC_METRICS_ENABLE=false
EVM_METRICS_BIND=127.0.0.1
EVM_METRICS_PORT=6065
